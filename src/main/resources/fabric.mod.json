{
  "schemaVersion": 1,
  "id": "bigger_fish",
  "version": "${version}",
  "name": "There's Always a Bigger Fish",
  "description": "A rework of fishing mechanics, adding new biome-specific fish to catch, a new fishing rod that can have bait attached, and a fishing minigame!",
  "authors": [
    "cassiancc",
    "malice-and-meat"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/always-a-bigger-fish",
    "sources": "https://github.com/cassiancc/Always-A-Bigger-Fish",
    "issues": "https://github.com/cassiancc/Always-A-Bigger-Fish/issues"
  },
  "license": "Multiple",
  "icon": "assets/bigger_fish/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "cc.cassian.bigger_fish.fabric.BiggerFishFabric"
    ],
    "client": [
      "cc.cassian.bigger_fish.fabric.client.BiggerFishFabricClient"
    ],
    "eiv": [
      "cc.cassian.bigger_fish.compat.eiv.EivIntegration"
    ],
    "emi": [
      "cc.cassian.bigger_fish.compat.emi.EmiCompat"
    ],
    "rei_client": [
      "cc.cassian.bigger_fish.compat.rei.ReiClient"
    ],
    "jei_mod_plugin": [
      "cc.cassian.bigger_fish.compat.jei.JeiIntegration"
    ]
  },
  "mixins": [
    "bigger_fish.mixins.json",
    "bigger_fish_fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.10",
    "fabric-api": "*",
    "minecraft": "${minecraft}",
    "java": ">=21"
  },
  "recommends": {
    "compost": "*"
  },
  "suggests": {
    "item-descriptions": "*",
    "cloth-config": "*",
    "modmenu": "*",
    "eiv": "*",
    "emi": "*"
  }
}
